PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3100
DATABASE_PATH=./data/cohortkit.db
# Postgres support is verified at the driver level (see docs); the app server currently runs on SQLite.
# DATABASE_URL=postgres://user:password@localhost:5432/cohortkit
# Explicitly local-only synthetic workspace and demo sign-in.
DEMO_MODE=true
# Live adapters are disabled until configured. No provider calls are made in demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
# Transactional email: Resend (RESEND_API_KEY), SMTP (SMTP_*), or console output when neither is set.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
